{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/project-design-answers.schema.json",
  "title": "Project Design Answers",
  "type": "object",
  "required": ["schema_version", "id", "status", "project", "questionnaire", "answers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "review_required", "approved", "superseded", "rejected"]},
    "project": {"type": "string", "minLength": 1},
    "questionnaire": {"type": "string", "minLength": 1},
    "answers": {"type": "array", "items": {"$ref": "#/$defs/answer"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string"}
  },
  "$defs": {
    "answer": {
      "type": "object",
      "required": ["question_id", "value"],
      "additionalProperties": false,
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "value": {},
        "source": {"type": "string", "enum": ["user", "agent_recommended", "default", "imported"]},
        "rationale": {"type": "string"}
      }
    }
  }
}
