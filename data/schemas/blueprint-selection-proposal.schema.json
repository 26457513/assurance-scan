{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/blueprint-selection-proposal.schema.json",
  "title": "Blueprint Selection Proposal",
  "type": "object",
  "required": ["schema_version", "id", "status", "project", "source_blueprints", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "review_required", "superseded", "rejected"]},
    "project": {"type": "string", "minLength": 1},
    "source_blueprints": {"type": "array", "items": {"$ref": "#/$defs/blueprint_ref"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "content_hash": {"type": "string"}
  },
  "$defs": {
    "blueprint_ref": {
      "type": "object",
      "required": ["id", "version", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "blueprint_fr", "decision", "rationale", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "blueprint_fr": {"type": "string", "minLength": 1},
        "blueprint_tbts": {"type": "array", "items": {"type": "string"}},
        "decision": {"type": "string", "enum": ["pending_review", "accepted_as_is", "tailored", "rejected", "not_applicable"]},
        "rationale": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/confidence"},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
