{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/blueprint-selection-proposal.schema.json",
  "title": "Blueprint Selection Proposal",
  "type": "object",
  "required": ["schema_version", "id", "status", "project", "source_blueprints", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "review_required", "superseded", "rejected"]},
    "project": {"type": "string", "minLength": 1},
    "source_blueprints": {"type": "array", "items": {"$ref": "#/$defs/blueprint_ref"}},
    "source_mapping_packs": {"type": "array", "items": {"$ref": "#/$defs/mapping_pack_ref"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "content_hash": {"type": "string"}
  },
  "$defs": {
    "blueprint_ref": {
      "type": "object",
      "required": ["id", "version", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string"}
      }
    },
    "mapping_pack_ref": {
      "type": "object",
      "required": ["id", "version", "path", "blueprint", "compliance"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string"},
        "blueprint": {"$ref": "#/$defs/blueprint_identity"},
        "compliance": {"$ref": "#/$defs/compliance_identity"}
      }
    },
    "blueprint_identity": {
      "type": "object",
      "required": ["catalog", "version"],
      "additionalProperties": false,
      "properties": {
        "catalog": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "compliance_identity": {
      "type": "object",
      "required": ["ruleset", "version"],
      "additionalProperties": false,
      "properties": {
        "ruleset": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "blueprint_fr", "decision", "rationale", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "blueprint_fr": {"type": "string", "minLength": 1},
        "blueprint_tbts": {"type": "array", "items": {"type": "string"}},
        "decision": {"type": "string", "enum": ["pending_review", "accepted_as_is", "tailored", "rejected", "not_applicable"]},
        "rationale": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/confidence"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "compliance_mappings": {"type": "array", "items": {"$ref": "#/$defs/candidate_compliance_mapping"}}
      }
    },
    "candidate_compliance_mapping": {
      "type": "object",
      "required": ["ruleset", "version", "mapping_ids", "rows", "domains"],
      "additionalProperties": false,
      "properties": {
        "ruleset": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "version": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "enum": ["satisfies", "supports", "related", "not_applicable"]},
        "traceability_strength": {"type": "string", "enum": ["direct", "partial", "advisory", "unmapped"]},
        "mapping_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/ruleset_row_ref"}, "uniqueItems": true},
        "domains": {"type": "array", "items": {"$ref": "#/$defs/compliance_domain_ref"}, "uniqueItems": true}
      }
    },
    "ruleset_row_ref": {
      "type": "object",
      "required": ["ruleset", "row"],
      "additionalProperties": false,
      "properties": {
        "ruleset": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "row": {"type": "string", "minLength": 1}
      }
    },
    "compliance_domain_ref": {
      "type": "object",
      "required": ["ruleset", "domain"],
      "additionalProperties": false,
      "properties": {
        "ruleset": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "domain": {"type": "string", "minLength": 1},
        "label": {"type": "string"}
      }
    }
  }
}
