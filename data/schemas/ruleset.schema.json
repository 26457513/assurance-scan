{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/ruleset.schema.json",
  "title": "Compliance Ruleset Snapshot",
  "description": "Tool-owned snapshot of compliance rows or controls such as ASVS, NIST 800-53, CIS, ISO 27001 or PCI-DSS.",
  "type": "object",
  "required": ["schema_version", "ruleset", "version", "title", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "ruleset": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source": {"$ref": "#/$defs/source"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string"},
        "license": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_file": {"type": "string"}
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "group": {"type": "string"},
        "section": {"type": "string"},
        "level": {"type": "string"},
        "parent": {"type": ["string", "null"]},
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
