{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/fr-catalog.schema.json",
  "title": "Functional Requirements Catalog",
  "description": "Project-owned Functional Requirements and TBT Test Basis definitions.",
  "type": "object",
  "required": ["schema_version", "project", "frs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/ruleset_scope"}
    },
    "na_rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/na_row"}
    },
    "frs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fr"}
    },
    "tbts": {
      "type": "array",
      "items": {"$ref": "#/$defs/tbt"}
    }
  },
  "$defs": {
    "ruleset_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "baselines": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "profiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "saq": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "include_rows": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "exclude_rows": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason": {"type": "string"}
      }
    },
    "na_row": {
      "type": "object",
      "required": ["ruleset", "row", "reason"],
      "additionalProperties": false,
      "properties": {
        "ruleset": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "row": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "fr": {
      "type": "object",
      "required": ["id", "title", "lifecycle_status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^FR-[A-Za-z0-9_.-]+$"},
        "parent": {"type": "string", "pattern": "^FR-[A-Za-z0-9_.-]+$"},
        "title": {"type": "string", "minLength": 1},
        "lifecycle_status": {"type": "string", "enum": ["draft", "in_scope", "deferred", "not_applicable", "retired"]},
        "category": {"type": "string"},
        "description": {"type": "string"},
        "derived_from": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/derived_from"},
        "assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
        "implemented_by": {"type": "array", "items": {"$ref": "#/$defs/code_ref"}},
        "satisfies": {"type": "array", "items": {"$ref": "#/$defs/ruleset_row_ref"}},
        "metadata": {"type": "object", "additionalProperties": true}
      }
    },
    "assignment": {
      "type": "object",
      "required": ["party", "responsibility"],
      "additionalProperties": false,
      "properties": {
        "party": {"type": "string", "minLength": 1},
        "responsibility": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/graph_responsibility"},
        "source": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "code_ref": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["glob", "file", "symbol", "url"]},
        "path": {"type": "string", "minLength": 1},
        "label": {"type": "string"}
      }
    },
    "ruleset_row_ref": {
      "type": "object",
      "required": ["ruleset", "row"],
      "additionalProperties": false,
      "properties": {
        "ruleset": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "row": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "enum": ["satisfies", "supports", "not_applicable"], "default": "satisfies"},
        "reason": {"type": "string"}
      }
    },
    "tbt": {
      "type": "object",
      "required": ["id", "title", "type", "lifecycle_status", "proves", "compliance", "evidence_policy"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^TBT-[A-Za-z0-9_.-]+$"},
        "title": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["unit", "integration", "e2e", "load", "scanner", "manual_review", "document_review", "approval"]
        },
        "lifecycle_status": {"type": "string", "enum": ["planned", "implemented", "deprecated"]},
        "proves": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^FR-[A-Za-z0-9_.-]+$"},
          "uniqueItems": true
        },
        "compliance": {
          "type": "array",
          "description": "Compliance rows or controls this TBT is designed to prove. This is the authoritative TBT-to-regime edge used by graphs and assurance status.",
          "items": {"$ref": "#/$defs/ruleset_row_ref"},
          "uniqueItems": true
        },
        "evidence_policy": {"$ref": "#/$defs/evidence_policy"},
        "expected_evidence": {"type": "array", "items": {"$ref": "#/$defs/expected_evidence"}},
        "runner": {"type": "string"},
        "ref": {"type": "string"},
        "derived_from": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/derived_from"},
        "metadata": {"type": "object", "additionalProperties": true}
      }
    },
    "expected_evidence": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/evidence_type"},
        "format": {"type": "string"},
        "required": {"type": "boolean", "default": true},
        "strength": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/evidence_strength"},
        "source": {"type": "string"},
        "match": {"$ref": "#/$defs/evidence_match"},
        "notes": {"type": "string"}
      }
    },
    "evidence_match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rule_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "metadata": {"type": "object", "additionalProperties": true}
      }
    },
    "evidence_strength": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/evidence_strength"},
    "evidence_policy": {
      "type": "string",
      "enum": ["all_required", "any_required", "automated_required", "manual_plus_automated", "manual_decision"]
    }
  }
}
