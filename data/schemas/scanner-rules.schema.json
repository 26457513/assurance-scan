{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/scanner-rules.schema.json",
  "title": "Scanner Rules Catalog",
  "description": "Optional scanner-native rule metadata. Compliance mappings live only in scanner-compliance-mapping-pack files.",
  "type": "object",
  "required": ["schema_version", "scanner", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "scanner": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "title", "evidence_type"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical", "unknown"]},
        "evidence_type": {"type": "string", "enum": ["scanner_result"]},
        "metadata": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
