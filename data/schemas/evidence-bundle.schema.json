{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/evidence-bundle.schema.json",
  "title": "Evidence Bundle",
  "description": "Observed or reviewed evidence produced by TBTs, with hash-addressable provenance for verification.",
  "type": "object",
  "required": ["schema_version", "project", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["id", "type", "result_status", "produced_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "type": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/evidence_type"},
        "result_status": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/evidence_result"},
        "produced_by": {"type": "string", "pattern": "^TBT-[A-Za-z0-9_.-]+$"},
        "observed": {"type": "boolean", "default": true},
        "evidence_strength": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/evidence_strength"},
        "fr_refs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^FR-[A-Za-z0-9_.-]+$"},
          "uniqueItems": true
        },
        "ruleset_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/ruleset_row_ref"}
        },
        "assurance_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/assurance_ref"}
        },
        "source": {"type": "string"},
        "source_locator": {"type": "string"},
        "artifact": {"$ref": "#/$defs/artifact_ref"},
        "raw_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_ref"}
        },
        "inputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_ref"}
        },
        "outputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_ref"}
        },
        "side_effects": {
          "type": "array",
          "items": {"$ref": "#/$defs/side_effect"}
        },
        "test_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/test_action"}
        },
        "normalized_finding": {"$ref": "#/$defs/normalized_finding"},
        "mapping_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/mapping_ref"}
        },
        "source_excerpt": {"type": "string"},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "tool": {"type": "string"},
        "run_id": {"type": "string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "metadata": {"type": "object", "additionalProperties": true}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["test_result", "scanner_result", "document", "approval", "screenshot"]}}, "required": ["type"]},
          "then": {"required": ["source"]}
        },
        {
          "if": {"properties": {"type": {"enum": ["document", "screenshot", "manual_note"]}}, "required": ["type"]},
          "then": {"required": ["reviewer"]}
        }
      ]
    },
    "ruleset_row_ref": {
      "type": "object",
      "required": ["ruleset", "row"],
      "additionalProperties": false,
      "properties": {
        "ruleset": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "row": {"type": "string", "minLength": 1}
      }
    },
    "assurance_ref": {
      "type": "object",
      "required": ["assurance_framework"],
      "additionalProperties": false,
      "properties": {
        "assurance_framework": {"type": "string", "minLength": 1},
        "flow_id": {"type": "string"},
        "gate_id": {"type": "string"},
        "criterion_id": {"type": "string"}
      }
    },
    "artifact_ref": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "media_type": {"type": "string"},
        "locator": {"type": "string"},
        "schema_ref": {"type": "string"}
      }
    },
    "side_effect": {
      "type": "object",
      "required": ["type", "target", "description"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "process_execution",
            "scanner_execution",
            "file_write",
            "db_write",
            "network_call",
            "container_execution",
            "review_record",
            "manual_action",
            "unknown"
          ]
        },
        "target": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "mode": {
          "type": "string",
          "enum": [
            "observed",
            "non_destructive",
            "read_only_analysis",
            "review_only",
            "manual",
            "unknown"
          ]
        }
      }
    },
    "test_action": {
      "type": "object",
      "required": ["type", "name", "target", "status", "description"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "testcase_execution",
            "junit_identity_recorded",
            "assertion_observed",
            "diagnostic_recorded",
            "fixture_setup",
            "fixture_teardown",
            "unknown"
          ]
        },
        "name": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "status": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/evidence_result"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "mapping_ref": {
      "type": "object",
      "required": ["mapping_id", "mapping_pack"],
      "additionalProperties": false,
      "properties": {
        "mapping_id": {"type": "string", "minLength": 1},
        "mapping_pack": {"type": "string", "minLength": 1},
        "ruleset": {"$ref": "https://github.com/jondowson/asvs-scanner/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "row": {"type": "string"},
        "domain": {"type": "string"},
        "selector": {"type": "string"}
      }
    },
    "normalized_finding": {
      "type": "object",
      "required": ["scanner", "finding_id"],
      "additionalProperties": false,
      "properties": {
        "scanner": {"type": "string", "minLength": 1},
        "finding_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string"},
        "category": {"type": "string"},
        "severity": {"type": "string"},
        "location": {"type": "string"},
        "message": {"type": "string"},
        "fingerprint": {"type": "string"},
        "raw_artifact_path": {"type": "string"},
        "raw_artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collector": {"type": "string"},
        "collected_at": {"type": "string", "format": "date-time"},
        "tool": {"type": "string"},
        "tool_version": {"type": "string"},
        "container_image": {"type": "string"},
        "container_digest": {"type": "string"},
        "command": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"type": "string"},
        "input_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_ref"}
        },
        "output_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_ref"}
        },
        "normalizer": {"type": "string"},
        "normalizer_version": {"type": "string"},
        "source_hash": {"type": "string"}
      }
    }
  }
}
