{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/code-generator-handoff-pack.schema.json",
  "title": "Code Generator Handoff Pack",
  "type": "object",
  "required": ["schema_version", "id", "project", "source_contract", "source_contract_hash", "tasks", "gates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "source_contract": {"type": "string", "minLength": 1},
    "source_contract_hash": {"type": "string", "minLength": 1},
    "source_design": {"type": "string"},
    "tasks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "gates": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "evidence_expectations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "content_hash": {"type": "string"}
  }
}
