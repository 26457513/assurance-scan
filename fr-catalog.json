      "tests": [
        {
          "id": "junit-parsing",
          "type": "unit-test",
          "name_pattern": "tests.phase1.test_junit_parser::*",
          "description": "JUnit XML parsed into per-testcase records (pass/fail/error/skip). Empty + malformed input graceful. testsuites wrapper supported. XXE-resistant via defusedxml.",
          "display": {
            "output_example": [
              {
                "suite_id": "s",
                "name": "test_ok",
                "classname": "tests.test_mod",
                "qualified_name": "tests.test_mod::test_ok",
                "result": "pass"
              },
              {
                "suite_id": "s",
                "name": "test_bad",
                "classname": "tests.test_mod",
                "qualified_name": "tests.test_mod::test_bad",
                "result": "fail",
                "failure_message": "assert false"
              }
            ],
            "output": {
              "expected": "TestCaseResult[] with qualified_name = classname::name, result in {pass, fail, error, skip}"
            },
            "side_effect": [
              "none"
            ],
            "input_example": {
              "format": "junit-xml",
              "bytes": "<testsuite name=\"s\">\\n  <testcase name=\\\"test_ok\\\" classname=\\\"tests.test_mod\\\"/>\\n  <testcase name=\\\"test_bad\\\">\\n    <failure message=\\\"assert false\\\"/>\\n  </testcase>\\n</testsuite>"
            },
            "input": {
              "junit_xml": "bytes from pytest / jest-junit / gradle / maven surefire"
            }
          }
        }
      ]
    },
