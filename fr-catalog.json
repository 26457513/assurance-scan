  "frs": [
    {
      "id": "FR-CATALOGUE-LOAD",
      "title": "Load and validate an FR catalogue from JSON",
      "description": "Given a path to a v3 catalogue JSON file, the system reads it, validates against the schema, snapshots it immutably into the DB, and makes its FRs available for state computation.",
      "category": "core",
      "implemented_by": [
        {
          "kind": "file",
          "ref": "server/catalogue/loader.py"
        },
        {
          "kind": "file",
          "ref": "server/db/repositories/catalogue_snapshots.py"
        }
      ],
      "tests": [
        {
          "id": "loader-validation",
          "type": "unit-test",
          "name_pattern": "tests.phase1.test_catalogue::*",
          "description": "Loader accepts valid v3 catalogues and rejects malformed ones.",
          "display": {
            "output_example": {
              "id": 42,
              "project_path": "/path/to/project",
              "catalogue_version": "2026-08-07T00:00:00Z",
              "content_hash": "sha256:abc123...",
              "created_at": "2026-08-08T12:00:00Z"
            },
            "output": {
              "expected": "snapshot row inserted, FRs queryable, malformed input rejected"
            },
            "side_effect": [
              "db-write"
            ],
            "input_example": {
              "schema_version": 3,
              "project": "example-project",
              "frs": [
                {
                  "id": "FR-1",
                  "title": "Do thing",
                  "description": "...",
                  "category": "core",
                  "implemented_by": [
                    {
                      "kind": "file",
                      "ref": "src/thing.py"
                    }
                  ],
                  "tests": [
                    {
                      "id": "t1",
                      "type": "unit-test",
                      "name_pattern": "tests/test_thing::*"
                    }
                  ],
                  "satisfies": [],
                  "depends_on": []
                }
              ]
            },
            "input": {
              "catalogue_path": "./fr-catalog.json",
              "schema": "v3"
            }
          }
        }
      ]
    },
    {
      "id": "FR-STATE-COMPUTE",
      "title": "Compute FR state from test results",
      "description": "After tests run, the system computes a state per FR (untested | pending | passed | failed | waived | blocked) using the precedence ladder.",
      "category": "core",
      "implemented_by": [
        {
          "kind": "file",
          "ref": "server/state/resolver.py"
        },
        {
          "kind": "file",
          "ref": "server/evidence/state_compute.py"
        }
      ],
      "tests": [
        {
          "id": "state-machine",
          "type": "unit-test",
          "name_pattern": "tests.phase1.test_state::*",
          "description": "8-state precedence ladder exercised across all transitions.",
          "display": {
            "output_example": {
              "state": "passed",
              "evaluations": {
                "t1": {
                  "result": "pass"
                }
              }
            },
            "output": {
              "expected": "FR state per 8-step precedence ladder (untested|pending|passed|failed|waived|blocked)"
            },
            "side_effect": [
              "none"
            ],
            "input_example": {
              "fr": {
                "id": "FR-1",
                "tests": [
                  {
                    "id": "t1",
                    "type": "scanner-clean",
                    "scanner": "x"
                  }
                ],
                "depends_on": []
              },
              "evaluations": {
                "t1": {
                  "result": "pass"
                }
              },
              "waivers_present": false,
              "dep_states": {}
            },
            "input": {
              "test_evaluations": "per-test pass/fail/pending dict",
              "waivers_present": "bool",
              "dep_states": "transitive dependency states"
            }
          }
        }
      ]
    },
    {
      "id": "FR-EVIDENCE-MATCH",
