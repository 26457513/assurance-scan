      "tests": [
        {
          "id": "parsers",
          "type": "unit-test",
          "name_pattern": "tests.phase1.test_parsers::*",
          "description": "Per-scanner parsers correctly normalize SARIF/JSON output.",
          "display": {
            "output_example": [
              {
                "scanner_kind": "semgrep",
                "severity": "HIGH",
                "rule_id": "python.lang.security.insecure-hash-algorithm-sha1",
                "file_path": "src/main.py",
                "line_start": 10,
                "message": "Detected SHA1"
              }
            ],
            "output": {
              "expected": "normalized findings list with severity, file_path, rule_id, message"
            },
            "side_effect": [
              "none"
            ],
            "input_example": {
              "scanner": "semgrep",
              "format": "sarif",
              "raw": {
                "version": "2.1.0",
                "runs": [
                  {
                    "tool": {
                      "driver": {
                        "name": "semgrep"
                      }
                    },
                    "results": [
                      {
                        "ruleId": "python.lang.security.insecure-hash-algorithm-sha1",
                        "level": "error",
                        "message": {
                          "text": "Detected SHA1"
                        },
                        "locations": [
                          {
                            "physicalLocation": {
                              "artifactLocation": {
                                "uri": "src/main.py"
                              },
                              "region": {
                                "startLine": 10
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            "input": {
              "scanner_outputs": "SARIF (semgrep), JSON (gitleaks, trivy, grype, syft, osv-scanner)"
            }
          }
        }
      ]
    },
