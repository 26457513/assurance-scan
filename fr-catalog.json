      "id": "FR-SCAN-EXEC",
      "title": "Execute configured scanners against a codebase",
      "description": "When a scan is requested, the system spawns each configured scanner as a sibling container via the host docker socket, captures stdout/stderr, parses findings, and stores raw artifacts + normalized findings in SQLite.",
      "category": "scan",
      "implemented_by": [
        {
          "kind": "file",
          "ref": "server/worker/orchestrator.py"
        },
        {
          "kind": "file",
