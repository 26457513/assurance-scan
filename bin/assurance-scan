#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
DEFAULT_IMAGE_BUNDLE_DIR="/opt/assurance-scan"
if [ ! -d "$DEFAULT_IMAGE_BUNDLE_DIR" ]; then
  DEFAULT_IMAGE_BUNDLE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
IMAGE_BUNDLE_DIR="${ASSURANCE_SCAN_IMAGE_BUNDLE_DIR:-$DEFAULT_IMAGE_BUNDLE_DIR}"

if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then
  C_RESET=$'\033[0m'
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_RED=$'\033[31m'
  C_CYAN=$'\033[36m'
  C_BLUE=$'\033[34m'
else
  C_RESET=""
  C_DIM=""
  C_BOLD=""
  C_GREEN=""
  C_YELLOW=""
  C_RED=""
  C_CYAN=""
  C_BLUE=""
fi

DIVIDER="────────────────────────────────────────────────────────────"

wrapper_banner() {
  printf '\n%s\n' "${C_CYAN}${C_BOLD}╭────────────────────────────────────────────╮${C_RESET}"
  printf '%s\n' "${C_CYAN}${C_BOLD}│              Assurance Scan                │${C_RESET}"
  printf '%s\n' "${C_CYAN}${C_BOLD}╰────────────────────────────────────────────╯${C_RESET}"
  printf '%s\n\n' "${C_DIM}Config-driven assurance scanner${C_RESET}"
}

wrapper_section() {
  printf '\n%s\n' "${C_DIM}${DIVIDER}${C_RESET}"
  printf '%s\n' "${C_BOLD}${C_BLUE}$*${C_RESET}"
}

wrapper_ok() {
  printf '  %-28s %s%s%s\n' "$1" "$C_GREEN" "$2" "$C_RESET"
}

wrapper_warn() {
  printf '  %-28s %s%s%s\n' "$1" "$C_YELLOW" "$2" "$C_RESET"
}

wrapper_info() {
  printf '  %-28s %s%s%s\n' "$1" "$C_DIM" "$2" "$C_RESET"
}

format_seconds() {
  local total="$1"
  local mins secs
  mins=$((total / 60))
  secs=$((total % 60))
  if [ "$mins" -gt 0 ]; then
    printf '%dm %02ds' "$mins" "$secs"
  else
    printf '%ds' "$secs"
  fi
}

usage() {
  cat <<'USAGE'
Assurance Scan

Usage:
  assurance-scan scan <host-project-dir> [--image <name>]... [--url <url>]... [--uploads <host-dir>]... [--fr-catalog <json>] [--compliance-mapping-pack <json>] [--scanner-compliance-mapping-pack <json-or-dir>]... [--assurance-framework <json>] [--assurance-instance <json>] [--carry-forward-report <report-dir>] [--no-auto-build-images]
  assurance-scan validate-report <report-dir> [--strict]
  assurance-scan validate-scanner-compliance-mappings [path-or-dir]...
  assurance-scan validate-blueprint-compliance-coverage --blueprint <fr-catalog.json> --mapping-pack <json>...
  assurance-scan propose-blueprint-frs --project <id> --blueprint <fr-catalog.json> --output <proposal.json> [--config-selection <json>] [--include-all]
  assurance-scan blueprint-decisions-to-config-update --project <id> --run-id <id> --proposal <json> --decisions <json> --blueprint <fr-catalog.json> --output <proposal.json>
  assurance-scan apply-reviewed-scope --run-id <id> --fr-catalog <json> --fr-catalog-out <json> --reviewed-by <name> [--proposal <json>] [--decisions <json>] [--accept-all-blueprints]
  assurance-scan validate-config-update <proposal.json> [validator flags]
  assurance-scan review-config-update <proposal.json> [--output <review.md>]
  assurance-scan apply-config-update <proposal.json> --select <section:index> --reviewed-by <name> [apply flags]
  assurance-scan generate-missing-tests <report-dir>
  assurance-scan promote-assurance-specs <report-dir> [--tbt TBT-018]...
  assurance-scan run-approved-tests <report-dir> --tbt TBT-018 [--source-repo <dir>]
  assurance-scan refresh-approved-test-evidence <report-dir> [--junit-xml <file>]
  assurance-scan update-project-fr-board-state <report-dir> [--state-json <json> | --validate-only] [--refresh-dashboard]
  assurance-scan export-assurance-claim <report-dir> --claim-type <type> --target <id>
  assurance-scan verify-assurance-claim <claim.json> --report-dir <report-dir>
  assurance-scan export-assurance-proof-bundle <claim.json> --report-dir <report-dir>
  assurance-scan verify-assurance-proof-bundle <bundle.json> [--report-dir <report-dir>]
  assurance-scan safe-image-worktree <host-project-dir> [branch-name]
  assurance-scan prefetch [--only trivy,grype,osv,clamav]
  assurance-scan help

Docker image example:
  docker run --rm -it \
    -e ASSURANCE_SCAN_IMAGE_BUILD_PARALLELISM=2 \
    -e ASSURANCE_SCAN_PARALLELISM=4 \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$(dirname "$PWD"):$(dirname "$PWD")" \
    -w "$PWD" \
    assurance-scan:latest scan "$PWD"

Useful scan flags:
  --fr-catalog <json>             Project FR/TBT catalog for traceability
  --compliance-mapping-pack <json> Ruleset row to FR/TBT sufficiency mappings
  --scanner-compliance-mapping-pack <json-or-dir>
                                  Scanner result to compliance-row evidence mappings
  --assurance-framework <json>    Gate/role/criterion framework such as JSP-453
  --assurance-instance <json>     Project mappings, role assignments and decisions
  --junit-xml <file>              Existing test execution evidence to import
  --carry-forward-report <dir>    Preserve report-local generated tests and Project FR board state from a previous report

Config proposal workflow:
  validate-scanner-compliance-mappings
                                  Validate scanner rule/finding to compliance-row mapping packs
  validate-blueprint-compliance-coverage
                                  Validate blueprint FR/TBT coverage across blueprint-to-compliance mapping packs
  propose-blueprint-frs           Propose reusable blueprint FR/TBT chains for project review
  blueprint-decisions-to-config-update
                                  Convert accepted blueprint decisions to config-update proposal JSON
  apply-reviewed-scope             One-command wrapper to apply reviewed blueprint scope into a reviewed FR catalog
  validate-config-update           Validate agent-authored config proposal JSON
  review-config-update             Render a human review brief for a proposal
  apply-config-update              Apply selected reviewed entries to explicit output files
    Use --assurance-framework with --assurance-instance-out to validate gate, role and criterion references.
    Use --assurance-test-pack with --assurance-test-pack-out to accept reviewed native-test mappings.
  generate-missing-tests           Generate report-local TBT assurance test specifications without claiming evidence
  promote-assurance-specs          Promote selected TBT specs into review-required report-local test scaffolds
  run-approved-tests               Run ready-to-run ASVS tests and emit JUnit XML for import
  refresh-approved-test-evidence   Refresh current report graphs from approved-test JUnit without a full scan
  update-project-fr-board-state    Save or validate report-local Project FR board decisions
  export-assurance-claim           Export a hash-bound typed claim from graph-manifest.json
  verify-assurance-claim           Verify a typed claim against graph-manifest.json and dashboard-payload.json
  export-assurance-proof-bundle    Export a selective-disclosure proof bundle for a claim
  verify-assurance-proof-bundle    Verify a proof bundle and optional disclosed openings

Mount the parent directory at the same absolute path inside the container. The
scanner creates a fresh assurance Git worktree beside the repo and scans that copy.
Reports are written to the safe worktree under .assurance-scan/runtime/reports.

When no --image flags are supplied, scan automatically builds images from
Dockerfiles found in the safe worktree and scans those images too.
Built scan images are tagged by source commit and reused on later scans of the
same commit. Set ASSURANCE_SCAN_FORCE_IMAGE_BUILD=1 to rebuild them.
Image builds run in parallel by default with ASSURANCE_SCAN_IMAGE_BUILD_PARALLELISM=2.

Scanner containers run concurrently by default. Set ASSURANCE_SCAN_PARALLELISM=1 for
sequential troubleshooting, or raise it on machines with more CPU/RAM.

Scanner databases are cached in Docker named volumes and refresh at most once
every 24 hours during normal scans. Set ASSURANCE_SCAN_DB_REFRESH_TTL_HOURS=0 to refresh
every run, or run "assurance-scan prefetch" to force a refresh.

For repos that need temporary Dockerfile/build changes before image scanning,
safe-image-worktree creates a separate Git worktree and branch without
switching the main checkout.
USAGE
}

die() {
  echo "ERROR: $*" >&2
  exit 2
}

to_abs_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PWD" "$1" ;;
  esac
}

ensure_runtime() {
  local runtime_dir="${ASSURANCE_SCAN_WORKDIR:-$PWD/.assurance-scan/runtime}"
  mkdir -p "$runtime_dir"
  (
    cd "$IMAGE_BUNDLE_DIR"
    tar \
      --exclude='./.git' \
      --exclude='./.assurance-scan' \
      --exclude='./reports' \
      --exclude='./scripts/__pycache__' \
      -cf - .
  ) | (
    cd "$runtime_dir"
    tar -xf -
  )
  chmod +x "$runtime_dir/run-local.sh" "$runtime_dir"/scripts/*.sh "$runtime_dir"/bin/assurance-scan 2>/dev/null || true
  printf '%s\n' "$runtime_dir"
}

create_source_snapshot() {
  local worktree_dir="$1"
  local snapshot_dir="$worktree_dir/.assurance-scan/source-snapshot"
  mkdir -p "$(dirname "$snapshot_dir")"
  rm -rf "$snapshot_dir"
  mkdir -p "$snapshot_dir"
  (
    cd "$worktree_dir"
    tar \
      --exclude='./.git' \
      --exclude='./.assurance-scan' \
      -cf - .
  ) | (
    cd "$snapshot_dir"
    tar -xf -
  )
  printf '%s\n' "$snapshot_dir"
}

safe_image_worktree() {
  local target_dir="$1"
  local requested_branch="${2:-}"
  create_safe_worktree "$target_dir" "image-scan" "$requested_branch"

  wrapper_section "Safe image-build worktree"
  wrapper_ok "source repo" "$SAFE_REPO_ROOT"
  wrapper_ok "base ref" "$SAFE_CURRENT_REF"
  wrapper_ok "branch" "$SAFE_BRANCH"
  wrapper_ok "worktree" "$SAFE_WORKTREE_DIR"
  echo ""
  printf '%s\n' "${C_CYAN}${C_BOLD}Next command:${C_RESET}"
  printf '  cd "%s"\n' "$SAFE_WORKTREE_DIR"
  printf '  docker run --rm -it -v /var/run/docker.sock:/var/run/docker.sock -v "$(dirname "$PWD"):$(dirname "$PWD")" -w "$PWD" assurance-scan:latest scan "$PWD"\n'
}

create_safe_worktree() {
  local target_dir="$1"
  local scan_kind="$2"
  local requested_branch="${3:-}"

  [ -d "$target_dir" ] || die "target directory is not visible: $target_dir"
  local target_base
  target_base="$(basename "$target_dir")"
  case "$target_base" in
    *-assurance-scan-*)
      if [ -d "$target_dir/.assurance-scan/runtime" ]; then
        die "target looks like a generated assurance-scan output folder, not the source project: $target_dir

Run this from the original project folder instead. For example, first run:
  cd /path/to/your/project
Then copy the scan command from the dashboard Instructions page."
      fi
      ;;
  esac
  git -C "$target_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "target is not a Git worktree: $target_dir"

  local repo_root
  repo_root="$(git -C "$target_dir" rev-parse --show-toplevel)"

  local current_ref
  current_ref="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'HEAD')"
  if [ "$current_ref" = "HEAD" ]; then
    current_ref="$(git -C "$repo_root" rev-parse --short HEAD)"
  fi

  local nonce branch worktree_parent repo_name worktree_dir sha8
  nonce="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  sha8="$(git -C "$repo_root" rev-parse --short=8 HEAD 2>/dev/null || printf '%s' "$nonce")"
  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)_${sha8}"
  export RUN_ID
  repo_name="$(basename "$repo_root")"
  if [ -n "$requested_branch" ]; then
    branch="$requested_branch"
  elif [ "$scan_kind" = "image-scan" ]; then
    branch="assurance/image-scan-$nonce"
  else
    branch="assurance/scan-$nonce"
  fi
  worktree_parent="$(dirname "$repo_root")"
  if [ "$scan_kind" = "image-scan" ]; then
    worktree_dir="${ASSURANCE_SCAN_IMAGE_WORKTREE_DIR:-$worktree_parent/${repo_name}-assurance-image-scan-$RUN_ID}"
  else
    worktree_dir="${ASSURANCE_SCAN_WORKTREE_DIR:-$worktree_parent/${repo_name}-assurance-scan-$RUN_ID}"
  fi

  [ ! -e "$worktree_dir" ] || die "worktree path already exists: $worktree_dir"
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    die "branch already exists: $branch"
  fi

  if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
    wrapper_section "Source state"
    wrapper_warn "uncommitted changes" "not included"
    wrapper_info "advice" "commit or stash changes that should be scanned"
  fi

  wrapper_section "Preparing safe scan branch"
  if git -C "$repo_root" worktree add --quiet -b "$branch" "$worktree_dir" HEAD >/dev/null 2>&1; then
    wrapper_ok "branch" "$branch"
    wrapper_ok "worktree" "$worktree_dir"
  else
    die "failed to create safe worktree at $worktree_dir"
  fi

  SAFE_REPO_ROOT="$repo_root"
  SAFE_CURRENT_REF="$current_ref"
  SAFE_BRANCH="$branch"
  SAFE_WORKTREE_DIR="$worktree_dir"
  SAFE_REPO_NAME="$repo_name"
  SAFE_NONCE="$nonce"
  SAFE_COMMIT="$(git -C "$worktree_dir" rev-parse --short=12 HEAD 2>/dev/null || printf '%s' "$nonce")"
}

sanitize_tag_part() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9_.-]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

dockerfile_for_build() {
  local dockerfile="$1"
  local context="$2"
  local component="$3"
  local build_root="$4"
  local generated_dir generated_dockerfile

  if grep -Eq '^[[:space:]]*COPY[[:space:]]+dist[[:space:]]+' "$dockerfile" \
    && [ ! -d "$context/dist" ] \
    && [ -f "$context/package.json" ] \
    && grep -q '"build:prod"' "$context/package.json"; then
    generated_dir="$build_root/generated-dockerfiles"
    generated_dockerfile="$generated_dir/$(sanitize_tag_part "$component").Dockerfile"
    mkdir -p "$generated_dir"
    cat > "$generated_dockerfile" <<'DOCKERFILE'
FROM node:20.12.2-alpine3.19 AS build

WORKDIR /app

RUN apk add --no-cache \
  python3 \
  make \
  g++ \
  cairo-dev \
  pango-dev \
  jpeg-dev \
  giflib-dev \
  pixman-dev \
  librsvg-dev \
  chromium \
  nss \
  freetype \
  harfbuzz \
  ca-certificates \
  ttf-freefont

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build:prod

FROM node:20.12.2-alpine3.19

WORKDIR /app

RUN apk add --no-cache \
  python3 \
  make \
  g++ \
  cairo-dev \
  pango-dev \
  jpeg-dev \
  giflib-dev \
  pixman-dev \
  librsvg-dev \
  chromium \
  nss \
  freetype \
  harfbuzz \
  ca-certificates \
  ttf-freefont

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY --from=build /app/dist/package.json ./
RUN rm -rf node_modules
RUN npm install && npm cache clean --force
COPY --from=build /app/dist .

CMD [ "node", "dist/bundle.js" ]
DOCKERFILE
    printf '%s\n' "$generated_dockerfile"
  else
    printf '%s\n' "$dockerfile"
  fi
}

append_injected_manifest() {
  local manifest="$1" path="$2"
  python3 - "$manifest" "$path" <<'PY' || true
import json, pathlib, sys
p, path = sys.argv[1], sys.argv[2]
data = json.loads(pathlib.Path(p).read_text() or "[]")
data.append({"path": path, "source": "gitignored_working_tree"})
pathlib.Path(p).write_text(json.dumps(data, indent=2))
PY
}

inject_gitignored_lockfiles() {
  local worktree_dir="$1"
  local repo_root="$2"
  local dockerfiles_file="$3"

  local lockfiles=("package-lock.json" "yarn.lock" "pnpm-lock.yaml")
  local runtime_dir="$worktree_dir/.assurance-scan/runtime"
  local manifest="$runtime_dir/injected-lockfiles.json"
  mkdir -p "$runtime_dir"
  printf '[]\n' > "$manifest"

  [ "${ASSURANCE_SCAN_INJECT_LOCKFILES:-1}" = "1" ] || return 0

  local dockerfile context rel source_ctx lockfile source_file injected=0
  while IFS= read -r dockerfile; do
    [ -n "$dockerfile" ] || continue
    context="$(dirname "$dockerfile")"
    if [ "$context" = "$worktree_dir" ]; then
      rel=""
      source_ctx="$repo_root"
    else
      rel="${context#$worktree_dir/}"
      source_ctx="$repo_root/$rel"
    fi
    for lockfile in "${lockfiles[@]}"; do
      source_file="$source_ctx/$lockfile"
      [ -f "$source_file" ] || continue
      [ -f "$context/$lockfile" ] && continue
      git -C "$repo_root" check-ignore -q "$source_file" 2>/dev/null || continue
      if cp "$source_file" "$context/$lockfile" \
        && git -C "$worktree_dir" add -f "$context/$lockfile" 2>/dev/null; then
        injected=$((injected + 1))
        wrapper_info "injected" "${rel:+$rel/}$lockfile"
        append_injected_manifest "$manifest" "${rel:+$rel/}$lockfile"
      else
        wrapper_warn "inject failed" "${rel:+$rel/}$lockfile"
      fi
    done
  done < "$dockerfiles_file"

  if [ "$injected" -gt 0 ]; then
    if git -C "$worktree_dir" -c user.email=assurance-scan@local \
        -c user.name="assurance-scan" commit -q \
        -m "assurance-scan: inject gitignored lockfiles for image build"; then
      wrapper_ok "lockfiles" "$injected injected"
    else
      wrapper_warn "lockfiles" "injected but commit failed"
    fi
  fi
}

auto_build_images() {
  local worktree_dir="$1"
  local repo_name="$2"
  local nonce="$3"
  local build_root="$worktree_dir/.assurance-scan"
  local build_log="$build_root/image-build.log"
  local jobs_dir="$build_root/image-build-jobs"
  local dockerfiles=()
  local base_dir dockerfile build_dockerfile context rel component tag builds_started_at image_key
  local build_parallelism job_index job_id

  builds_started_at="$(date +%s)"
  AUTO_IMAGE_BUILD_SECONDS=0
  build_parallelism="${ASSURANCE_SCAN_IMAGE_BUILD_PARALLELISM:-2}"
  if ! [[ "$build_parallelism" =~ ^[0-9]+$ ]] || [ "$build_parallelism" -lt 1 ]; then
    build_parallelism=1
  fi
  mkdir -p "$build_root" "$jobs_dir"
  : > "$build_log"

  if [ -f "$worktree_dir/Dockerfile" ]; then
    dockerfiles+=("$worktree_dir/Dockerfile")
  fi

  for base_dir in services apps packages; do
    if [ -d "$worktree_dir/$base_dir" ]; then
      while IFS= read -r dockerfile; do
        dockerfiles+=("$dockerfile")
      done < <(find "$worktree_dir/$base_dir" -mindepth 2 -maxdepth 2 -type f -name 'Dockerfile' | sort)
    fi
  done

  if [ ${#dockerfiles[@]} -eq 0 ]; then
    wrapper_section "Image build"
    wrapper_warn "dockerfiles" "none found; image scanners skipped"
    return 0
  fi

  local tmp_dockerfiles_file
  tmp_dockerfiles_file="$(mktemp)"
  printf '%s\n' "${dockerfiles[@]}" > "$tmp_dockerfiles_file"
  inject_gitignored_lockfiles "$worktree_dir" "$SAFE_REPO_ROOT" "$tmp_dockerfiles_file"
  rm -f "$tmp_dockerfiles_file"

  image_key="${ASSURANCE_SCAN_IMAGE_CACHE_KEY:-$(git -C "$worktree_dir" rev-parse --short=12 HEAD 2>/dev/null || printf '%s' "$nonce")}"

  wrapper_section "Image build"
  wrapper_ok "dockerfiles" "${#dockerfiles[@]} discovered"
  wrapper_info "parallelism" "$build_parallelism"
  printf '%s\n' "${C_DIM}  Log: $build_log${C_RESET}"
  AUTO_IMAGE_ARGS=()
  IMAGE_JOB_IDS=()
  IMAGE_JOB_RELS=()
  IMAGE_JOB_TAGS=()

  build_image_job() {
    local job_id="$1"
    local rel="$2"
    local build_dockerfile="$3"
    local tag="$4"
    local context="$5"
    local job_log="$jobs_dir/$job_id.log"
    local job_rc="$jobs_dir/$job_id.rc"
    local job_seconds="$jobs_dir/$job_id.seconds"
    local started_at elapsed rc

    {
      if [ "$build_dockerfile" != "$context/Dockerfile" ]; then
        echo "==> generated scan Dockerfile: $build_dockerfile"
      fi
      echo "==> docker build -f $build_dockerfile -t $tag $context"
    } > "$job_log"

    started_at="$(date +%s)"
    docker build -f "$build_dockerfile" -t "$tag" "$context" >> "$job_log" 2>&1
    rc=$?
    elapsed=$(( $(date +%s) - started_at ))
    printf '%s\n' "$rc" > "$job_rc"
    printf '%s\n' "$elapsed" > "$job_seconds"
  }

  job_index=0
  for dockerfile in "${dockerfiles[@]}"; do
    context="$(dirname "$dockerfile")"
    rel="${context#$worktree_dir/}"
    if [ "$context" = "$worktree_dir" ]; then
      component="app"
    else
      component="$(basename "$context")"
    fi
    tag="$(sanitize_tag_part "$repo_name-$component"):assurance-v1-$image_key"
    build_dockerfile="$(dockerfile_for_build "$dockerfile" "$context" "$component" "$build_root")"

    if [ "${ASSURANCE_SCAN_FORCE_IMAGE_BUILD:-0}" != "1" ] && docker image inspect "$tag" >/dev/null 2>&1; then
      wrapper_ok "$rel" "$tag (cached)"
      AUTO_IMAGE_ARGS+=("--image" "$tag")
      continue
    fi

    job_index=$((job_index + 1))
    job_id="$(printf '%03d' "$job_index")"
    IMAGE_JOB_IDS+=("$job_id")
    IMAGE_JOB_RELS+=("$rel")
    IMAGE_JOB_TAGS+=("$tag")
    while [ "$(jobs -pr | wc -l | tr -d ' ')" -ge "$build_parallelism" ]; do
      wait -n 2>/dev/null || true
    done
    printf '  %-28s %sbuilding%s\n' "$rel" "$C_YELLOW" "$C_RESET"
    build_image_job "$job_id" "$rel" "$build_dockerfile" "$tag" "$context" &
  done

  while [ "$(jobs -pr | wc -l | tr -d ' ')" -gt 0 ]; do
    sleep 20
    for i in "${!IMAGE_JOB_IDS[@]}"; do
      job_id="${IMAGE_JOB_IDS[$i]}"
      rel="${IMAGE_JOB_RELS[$i]}"
      if [ ! -f "$jobs_dir/$job_id.rc" ]; then
        latest_line="$(tail -1 "$jobs_dir/$job_id.log" 2>/dev/null | cut -c1-76)"
        printf '  %-28s %sbuilding%s %s%s\n' "$rel" "$C_DIM" "$C_RESET" "$C_DIM" "$latest_line"
      fi
    done
    wait -n 2>/dev/null || true
  done

  for i in "${!IMAGE_JOB_IDS[@]}"; do
    job_id="${IMAGE_JOB_IDS[$i]}"
    rel="${IMAGE_JOB_RELS[$i]}"
    tag="${IMAGE_JOB_TAGS[$i]}"
    {
      echo ""
      cat "$jobs_dir/$job_id.log" 2>/dev/null || true
    } >> "$build_log"
    rc="$(cat "$jobs_dir/$job_id.rc" 2>/dev/null || printf '1')"
    build_elapsed="$(cat "$jobs_dir/$job_id.seconds" 2>/dev/null || printf '0')"
    if [ "$rc" -eq 0 ]; then
      wrapper_ok "$rel" "$tag"
      printf '  %-28s %s%s%s\n' "$rel build time" "$C_DIM" "$(format_seconds "$build_elapsed")" "$C_RESET"
      AUTO_IMAGE_ARGS+=("--image" "$tag")
    else
      printf '  %-28s %sfailed%s\n' "$rel" "$C_RED" "$C_RESET"
      echo ""
      echo "Image build failed for: $rel"
      echo "Log: $jobs_dir/$job_id.log"
      echo ""
      tail -40 "$jobs_dir/$job_id.log" || true
      exit 1
    fi
  done
  AUTO_IMAGE_BUILD_SECONDS=$(( $(date +%s) - builds_started_at ))
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
if [ "${1:-}" = "" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "help" ]; then
  usage
  exit 0
fi

cmd="$1"
shift

export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-assurance-scan}"

case "$cmd" in
  scan)
    [ "${1:-}" != "" ] || die "scan requires a host project directory"
    export ASSURANCE_SCAN_RUN_START_EPOCH="${ASSURANCE_SCAN_RUN_START_EPOCH:-$(date +%s)}"
    wrapper_banner
    target_dir="$(to_abs_path "$1")"
    shift
    [ -d "$target_dir" ] || die "target directory is not visible inside the container: $target_dir

Mount it at the same absolute path, for example:
  docker run --rm -it -v /var/run/docker.sock:/var/run/docker.sock -v \"\$(dirname \"\$PWD\"):\$(dirname \"\$PWD\")\" -w \"\$PWD\" assurance-scan:latest scan \"\$PWD\""

    rewritten_args=()
    explicit_image_count=0
    auto_build_images_enabled=1
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --image)
          [ "${2:-}" != "" ] || die "--image requires an image name"
          explicit_image_count=$((explicit_image_count + 1))
          rewritten_args+=("--image" "$2")
          shift 2
          ;;
        --uploads)
          [ "${2:-}" != "" ] || die "--uploads requires a directory"
          rewritten_args+=("--uploads" "$(to_abs_path "$2")")
          shift 2
          ;;
        --fr-catalog)
          [ "${2:-}" != "" ] || die "--fr-catalog requires a JSON path"
          catalog_path="$(to_abs_path "$2")"
          [ -f "$catalog_path" ] || die "--fr-catalog file not found: $catalog_path"
          export ASSURANCE_SCAN_FR_CATALOG="$catalog_path"
          shift 2
          ;;
        --compliance-mapping-pack)
          [ "${2:-}" != "" ] || die "--compliance-mapping-pack requires a JSON path"
          compliance_mapping_path="$(to_abs_path "$2")"
          [ -f "$compliance_mapping_path" ] || die "--compliance-mapping-pack file not found: $compliance_mapping_path"
          export ASSURANCE_SCAN_COMPLIANCE_MAPPING_PACK="$compliance_mapping_path"
          shift 2
          ;;
        --scanner-compliance-mapping-pack)
          [ "${2:-}" != "" ] || die "--scanner-compliance-mapping-pack requires a JSON path or directory"
          scanner_compliance_mapping_path="$(to_abs_path "$2")"
          [ -e "$scanner_compliance_mapping_path" ] || die "--scanner-compliance-mapping-pack path not found: $scanner_compliance_mapping_path"
          rewritten_args+=("--scanner-compliance-mapping-pack" "$scanner_compliance_mapping_path")
          shift 2
          ;;
        --assurance-framework)
          [ "${2:-}" != "" ] || die "--assurance-framework requires a JSON path"
          assurance_framework_path="$(to_abs_path "$2")"
          [ -f "$assurance_framework_path" ] || die "--assurance-framework file not found: $assurance_framework_path"
          export ASSURANCE_SCAN_ASSURANCE_FRAMEWORK="$assurance_framework_path"
          shift 2
          ;;
        --assurance-instance)
          [ "${2:-}" != "" ] || die "--assurance-instance requires a JSON path"
          assurance_instance_path="$(to_abs_path "$2")"
          [ -f "$assurance_instance_path" ] || die "--assurance-instance file not found: $assurance_instance_path"
          export ASSURANCE_SCAN_ASSURANCE_INSTANCE="$assurance_instance_path"
          shift 2
          ;;
        --junit-xml)
          [ "${2:-}" != "" ] || die "--junit-xml requires a file path"
          junit_path="$(to_abs_path "$2")"
          [ -f "$junit_path" ] || die "--junit-xml file not found: $junit_path"
          export ASSURANCE_SCAN_JUNIT_XML="$junit_path"
          shift 2
          ;;
        --carry-forward-report)
          [ "${2:-}" != "" ] || die "--carry-forward-report requires a report directory"
          carry_forward_report="$(to_abs_path "$2")"
          [ -d "$carry_forward_report" ] || die "--carry-forward-report directory not found: $carry_forward_report"
          export ASSURANCE_SCAN_CARRY_FORWARD_REPORT="$carry_forward_report"
          shift 2
          ;;
        --no-auto-build-images)
          auto_build_images_enabled=0
          shift
          ;;
        *)
          rewritten_args+=("$1")
          shift
          ;;
      esac
    done

    create_safe_worktree "$target_dir" "scan" ""
    wrapper_section "Scan context"
    wrapper_ok "source repo" "$SAFE_REPO_ROOT"
    wrapper_ok "base ref" "$SAFE_CURRENT_REF"
    wrapper_ok "commit" "$SAFE_COMMIT"

    scan_source_dir="$(create_source_snapshot "$SAFE_WORKTREE_DIR")"
    wrapper_ok "source snapshot" "$scan_source_dir"

    if [ "$explicit_image_count" -eq 0 ] && [ "$auto_build_images_enabled" -eq 1 ]; then
      auto_build_images "$SAFE_WORKTREE_DIR" "$SAFE_REPO_NAME" "$SAFE_NONCE"
      export ASSURANCE_SCAN_IMAGE_BUILD_SECONDS="${AUTO_IMAGE_BUILD_SECONDS:-0}"
      if [ ${#AUTO_IMAGE_ARGS[@]} -gt 0 ]; then
        rewritten_args+=("${AUTO_IMAGE_ARGS[@]}")
        echo ""
      fi
    elif [ "$explicit_image_count" -gt 0 ]; then
      wrapper_section "Image build"
      wrapper_ok "mode" "using explicit --image tag(s)"
      export ASSURANCE_SCAN_IMAGE_BUILD_SECONDS=0
    else
      wrapper_section "Image build"
      wrapper_warn "mode" "skipped by --no-auto-build-images"
      export ASSURANCE_SCAN_IMAGE_BUILD_SECONDS=0
    fi

    export ASSURANCE_SCAN_WORKDIR="$SAFE_WORKTREE_DIR/.assurance-scan/runtime"
    export SCAN_SOURCE_DIR="$scan_source_dir"
    export ASSURANCE_SCAN_REPOSITORY_NAME="$SAFE_REPO_NAME"
    export ASSURANCE_SCAN_ORIGINAL_BRANCH="$SAFE_CURRENT_REF"
    export ASSURANCE_SCAN_SAFE_SCAN_BRANCH="$SAFE_BRANCH"
    export ASSURANCE_SCAN_SOURCE_REPO="$SAFE_REPO_ROOT"
    export ASSURANCE_SCAN_IMAGE_CACHE_KEY="$SAFE_COMMIT"
    export ASSURANCE_SCAN_BANNER_SHOWN=1
    runtime_dir="$(ensure_runtime)"
    exec "$runtime_dir/run-local.sh" "$SAFE_WORKTREE_DIR" "${rewritten_args[@]}"
    ;;
  safe-image-worktree)
    [ "${1:-}" != "" ] || die "safe-image-worktree requires a host project directory"
    target_dir="$(to_abs_path "$1")"
    shift
    branch_name="${1:-}"
    safe_image_worktree "$target_dir" "$branch_name"
    ;;
  validate-report)
    [ "${1:-}" != "" ] || die "validate-report requires a report directory"
    report_dir="$(to_abs_path "$1")"
    shift
    [ -d "$report_dir" ] || die "report directory not found: $report_dir"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/validate-report-artifacts.py" --report-dir "$report_dir" "$@"
    ;;
  validate-scanner-compliance-mappings)
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/validate-scanner-compliance-mappings.py" "$@"
    ;;
  validate-blueprint-compliance-coverage)
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/validate-blueprint-compliance-coverage.py" "$@"
    ;;
  propose-blueprint-frs)
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/propose-blueprint-frs.py" "$@"
    ;;
  blueprint-decisions-to-config-update)
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/blueprint-decisions-to-config-update.py" "$@"
    ;;
  apply-reviewed-scope)
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/apply-reviewed-scope.py" "$@"
    ;;
  validate-config-update)
    [ "${1:-}" != "" ] || die "validate-config-update requires a proposal JSON file"
    proposal_path="$(to_abs_path "$1")"
    shift
    [ -f "$proposal_path" ] || die "proposal JSON not found: $proposal_path"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/validate-config-update-proposal.py" "$proposal_path" "$@"
    ;;
  review-config-update)
    [ "${1:-}" != "" ] || die "review-config-update requires a proposal JSON file"
    proposal_path="$(to_abs_path "$1")"
    shift
    [ -f "$proposal_path" ] || die "proposal JSON not found: $proposal_path"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/review-config-update-proposal.py" "$proposal_path" "$@"
    ;;
  apply-config-update)
    [ "${1:-}" != "" ] || die "apply-config-update requires a proposal JSON file"
    proposal_path="$(to_abs_path "$1")"
    shift
    [ -f "$proposal_path" ] || die "proposal JSON not found: $proposal_path"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/apply-config-update-proposal.py" "$proposal_path" "$@"
    ;;
  generate-missing-tests)
    [ "${1:-}" != "" ] || die "generate-missing-tests requires a report directory"
    report_dir="$(to_abs_path "$1")"
    shift
    [ -d "$report_dir" ] || die "report directory not found: $report_dir"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/generate-missing-assurance-tests.py" --report-dir "$report_dir" "$@"
    ;;
  promote-assurance-specs)
    [ "${1:-}" != "" ] || die "promote-assurance-specs requires a report directory"
    report_dir="$(to_abs_path "$1")"
    shift
    [ -d "$report_dir" ] || die "report directory not found: $report_dir"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/promote-assurance-specs.py" --report-dir "$report_dir" "$@"
    ;;
  run-approved-tests)
    [ "${1:-}" != "" ] || die "run-approved-tests requires a report directory"
    report_dir="$(to_abs_path "$1")"
    shift
    [ -d "$report_dir" ] || die "report directory not found: $report_dir"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/run-approved-tests.py" "$report_dir" "$@"
    ;;
  refresh-approved-test-evidence)
    [ "${1:-}" != "" ] || die "refresh-approved-test-evidence requires a report directory"
    report_dir="$(to_abs_path "$1")"
    shift
    [ -d "$report_dir" ] || die "report directory not found: $report_dir"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/refresh-approved-test-evidence.py" "$report_dir" "$@"
    ;;
  update-project-fr-board-state)
    [ "${1:-}" != "" ] || die "update-project-fr-board-state requires a report directory"
    report_dir="$(to_abs_path "$1")"
    shift
    [ -d "$report_dir" ] || die "report directory not found: $report_dir"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/update-project-fr-board-state.py" "$report_dir" "$@"
    ;;
  export-assurance-claim)
    [ "${1:-}" != "" ] || die "export-assurance-claim requires a report directory"
    report_dir="$(to_abs_path "$1")"
    shift
    [ -d "$report_dir" ] || die "report directory not found: $report_dir"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/export-assurance-claim.py" "$report_dir" "$@"
    ;;
  verify-assurance-claim)
    [ "${1:-}" != "" ] || die "verify-assurance-claim requires a claim JSON file"
    claim_path="$(to_abs_path "$1")"
    shift
    [ -f "$claim_path" ] || die "claim JSON not found: $claim_path"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/verify-assurance-claim.py" "$claim_path" "$@"
    ;;
  export-assurance-proof-bundle)
    [ "${1:-}" != "" ] || die "export-assurance-proof-bundle requires a claim JSON file"
    claim_path="$(to_abs_path "$1")"
    shift
    [ -f "$claim_path" ] || die "claim JSON not found: $claim_path"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/export-assurance-proof-bundle.py" "$claim_path" "$@"
    ;;
  verify-assurance-proof-bundle)
    [ "${1:-}" != "" ] || die "verify-assurance-proof-bundle requires a bundle JSON file"
    bundle_path="$(to_abs_path "$1")"
    shift
    [ -f "$bundle_path" ] || die "bundle JSON not found: $bundle_path"
    runtime_dir="$(ensure_runtime)"
    exec python3 "$runtime_dir/scripts/verify-assurance-proof-bundle.py" "$bundle_path" "$@"
    ;;
  prefetch)
    runtime_dir="$(ensure_runtime)"
    exec "$runtime_dir/run-local.sh" prefetch "$@"
    ;;
  *)
    die "unknown command: $cmd"
    ;;
esac
fi
