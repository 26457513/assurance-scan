# Tapestry Security Assurance Scanner — environment file
#
# Copy to .env and fill in. The run-local.sh entrypoint sources this file
# before reading scanner-config.yaml, so yaml values override .env when both
# set the same key. Environment variables exported in your shell override both.
#
# v4 no longer requires an NVD API key — dependency-check was replaced by
# osv-scanner, which uses OSV.dev (no key, no rate limit). These keys are all
# optional and only affect scanner behavior in specific scenarios.

# Optional tokens for scanner ecosystems. Most local scans leave these blank.
GITHUB_TOKEN=
TRIVY_TOKEN=
SEMGREP_APP_TOKEN=
ZAP_API_KEY=

# Fallback per-scanner timeout (seconds).
SCANNER_TIMEOUT_DEFAULT=600
