# assurance-scan — copy to .env and fill in.

# Required: fine-grained PAT (resource owner = the org, Actions:Read +
# Contents:Read). Drives CI polling, org repo listing, and source peeks.
GITHUB_POLL_TOKEN=

# Optional overrides (defaults shown).
# GITHUB_ORG=26457513
# POLL_INTERVAL_SECONDS=60
# POLL_REPOS=

# Google Workspace login (hosted deployments; unset locally = no auth).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DOMAIN=barkleygen.com
# SESSION_SECRET=<random 32+ char string>
# PUBLIC_BASE_URL=https://scan.yourdomain.com
# Temporary pre-cutover GitHub account-linking window. Keep disabled until the
# GitHub App OAuth callback and credential encryption key are configured.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=<random 32+ char string>
# MIGRATION_GITHUB_LINKING_ENABLED=false
# Local scan uploads are a separate, account-bound bearer-token surface.
# They remain off unless Google account identity above is fully configured.
# Token listing and revocation remain available when creation is disabled.
# SCAN_TOKEN_CREATION_ENABLED=false
# Optional comma-separated account canary. Empty means all signed-in accounts,
# but only after SCAN_TOKEN_CREATION_ENABLED is true.
# SCAN_TOKEN_CREATION_USER_ALLOWLIST=admin@example.com,tester@example.com
# LOCAL_INGEST_ENABLED=false
# Optional comma-separated canonical owner/repository canary scope. Empty means
# no repository restriction, but only after LOCAL_INGEST_ENABLED is true.
# LOCAL_INGEST_REPOSITORY_ALLOWLIST=26457513/assurance-scan
# Every LOCAL_INGEST_* limit may be lowered from the advertised default, but
# startup rejects attempts to raise a compiled security ceiling. Examples:
# LOCAL_INGEST_WIRE_BYTES=33554432
# LOCAL_INGEST_UPLOADS_PER_TOKEN_HOUR=10
# LOCAL_INGEST_RETAINED_BYTES_PER_USER=1073741824
# Bearer token for MCP clients (claude mcp add --header "Authorization: Bearer ..."). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=
# Notion standup digest (token from notion.so Developer > PATs)
NOTION_TOKEN=
NOTION_PAGE_ID=
# Comma-separated GitHub orgs the Notion digest reports on (empty = all)
NOTION_ORGS=
