# Assurance Scan local development configuration. Never commit real values.

PUBLIC_BASE_URL=http://localhost:8742
SESSION_SECRET=<random-32+-character-value>
TOKEN_ENCRYPTION_KEY=<stable-random-encryption-key>

# GitHub App identity, OAuth and installation access.
GITHUB_APP_ACCESS_ENABLED=false
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/assurance-scan/github-app.pem
# Comma-separated immutable GitHub numeric IDs for protected administrators.
GITHUB_ADMIN_USER_IDS=

# Authenticated webhook and keyless GitHub Actions uploads.
GITHUB_WEBHOOK_ENABLED=false
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PREVIOUS_SECRET=
GITHUB_WEBHOOK_PREVIOUS_VALID_UNTIL=
GITHUB_OIDC_INGEST_ENABLED=false

# Local scan tokens and uploads are separately controlled.
SCAN_TOKEN_CREATION_ENABLED=false
# Optional comma-separated immutable GitHub numeric IDs; empty permits every
# signed-in user who also has current upload access to an installed repository.
SCAN_TOKEN_CREATION_GITHUB_USER_ALLOWLIST=
LOCAL_INGEST_ENABLED=false
LOCAL_INGEST_REPOSITORY_ALLOWLIST=

# Optional service integrations.
MCP_TOKEN=
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_ORGS=

ASSURANCE_SCAN_LOG_LEVEL=INFO
ASSURANCE_SCAN_PARALLELISM=4
