# Public local-scan CLI. Scanner engines run as pinned sibling containers; this
# image contains no hosted API, database migrations, MCP server, or frontend.
FROM docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c AS docker_cli
FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ARG VERSION=0.0.0-dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="Assurance Scan CLI" \
      org.opencontainers.image.description="Local source scanner and Assurance Scan upload client" \
      org.opencontainers.image.source="https://github.com/26457513/assurance-scan" \
      org.opencontainers.image.url="https://github.com/26457513/assurance-scan" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/assurance-scan/backend
COPY backend/scripts/local-cli.py ./scripts/local-cli.py
COPY backend/app/__init__.py ./app/__init__.py
COPY backend/app/modules/ ./app/modules/
COPY backend/app/infrastructure/__init__.py ./app/infrastructure/__init__.py
COPY backend/app/infrastructure/local_cli.py ./app/infrastructure/local_cli.py
COPY backend/resources/scanners/ ./resources/scanners/

ENV PYTHONPATH=/opt/assurance-scan/backend \
    ASSURANCE_SCAN_CLI_VERSION=${VERSION} \
    ASSURANCE_SCAN_CLI_REVISION=${REVISION} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ENTRYPOINT ["python3", "/opt/assurance-scan/backend/scripts/local-cli.py"]
