{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance-scan.dev/schemas/local-scan-findings.v1.schema.json",
  "title": "Assurance Scan source-neutral findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scanners", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "scanners": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/scannerResult"}
    },
    "findings": {
      "type": "array",
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/finding"}
    },
    "source_contexts": {
      "type": "array",
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/sourceContext"}
    }
  },
  "$defs": {
    "scannerKind": {
      "enum": [
        "semgrep",
        "gitleaks",
        "trivy-fs",
        "trivy-config",
        "trivy-image",
        "syft",
        "grype",
        "osv-scanner",
        "tribal"
      ]
    },
    "imageDigest": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "scannerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "duration_ms", "image", "tool_version"],
      "properties": {
        "kind": {"$ref": "#/$defs/scannerKind"},
        "status": {"enum": ["completed", "failed", "skipped"]},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "image": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/imageDigest"}
          ]
        },
        "tool_version": {"type": ["string", "null"], "maxLength": 128},
        "database_version": {"type": ["string", "null"], "maxLength": 256},
        "error_code": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanner",
        "rule_id",
        "severity",
        "file_path",
        "line_start",
        "line_end",
        "message",
        "theme",
        "fix_strategy",
        "compliance_tags"
      ],
      "properties": {
        "finding_key": {"type": "string", "format": "uuid"},
        "scanner": {"$ref": "#/$defs/scannerKind"},
        "rule_id": {"type": ["string", "null"], "maxLength": 256},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"]},
        "file_path": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/repositoryPath"}
          ]
        },
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "message": {"type": "string", "maxLength": 8192},
        "theme": {"type": ["string", "null"], "maxLength": 64},
        "fix_strategy": {"type": ["string", "null"], "maxLength": 64},
        "compliance_tags": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 128}
        }
      }
    },
    "sourceLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "text", "truncated"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "maxLength": 1024},
        "truncated": {"type": "boolean"}
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_key", "finding_keys", "available", "provider",
        "redaction_version", "redaction_changed"
      ],
      "properties": {
        "context_key": {"type": "string", "format": "uuid"},
        "finding_keys": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "format": "uuid"}
        },
        "available": {"type": "boolean"},
        "provider": {"const": "snapshot"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "window_start": {"type": "integer", "minimum": 1},
        "window_end": {"type": "integer", "minimum": 1},
        "highlight_start": {"type": "integer", "minimum": 1},
        "highlight_end": {"type": "integer", "minimum": 1},
        "highlight_truncated": {"type": "boolean"},
        "lines": {
          "type": "array", "maxItems": 11,
          "items": {"$ref": "#/$defs/sourceLine"}
        },
        "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "redaction_version": {"const": 1},
        "redaction_changed": {"type": "boolean"},
        "unavailable_reason": {
          "enum": [
            "binary", "context_limit", "decode_error", "file_too_large",
            "invalid_path", "missing_file", "missing_line", "missing_path",
            "not_uploaded", "request_limit", "untrusted_range"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"available": {"const": true}}},
          "then": {
            "required": [
              "path", "window_start", "window_end", "highlight_start",
              "highlight_end", "highlight_truncated", "lines", "source_hash"
            ]
          },
          "else": {"required": ["unavailable_reason"]}
        }
      ]
    }
  }
}
