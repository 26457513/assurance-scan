{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/project-assurance-contract.schema.json",
  "title": "Project Assurance Contract Export",
  "description": "Derived export bundle that references canonical assurance artifacts produced from an approved planning contract.",
  "type": "object",
  "required": ["schema_version", "id", "project", "derived_from_contract", "artifacts", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "derived_from_contract": {"type": "string", "minLength": 1},
    "derived_from_contract_hash": {"type": "string"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["kind", "path"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["fr_catalog", "compliance_regime", "compliance_mapping_pack", "blueprint_compliance_mapping_pack", "scanner_compliance_mapping_pack", "assurance_framework", "assurance_instance", "evidence_policy", "graph_manifest"]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string"}
      }
    }
  }
}
