{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/blueprint-compliance-mapping-pack.schema.json",
  "title": "Blueprint Compliance Mapping Pack",
  "description": "Versioned reviewed mappings from regime-neutral blueprint FR/TBT templates to compliance rows or domains for one compliance regime/version.",
  "type": "object",
  "required": [
    "schema_version",
    "pack",
    "blueprint",
    "compliance",
    "mappings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "pack": {
      "$ref": "#/$defs/pack"
    },
    "blueprint": {
      "$ref": "#/$defs/blueprint"
    },
    "compliance": {
      "$ref": "#/$defs/compliance"
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "required": [
        "pack_id",
        "pack_version",
        "created_at",
        "updated_at",
        "generator"
      ],
      "additionalProperties": false,
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string"
        },
        "input_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_artifact"
          }
        }
      }
    },
    "input_artifact": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      }
    },
    "blueprint": {
      "type": "object",
      "required": [
        "catalog",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string"
        },
        "source_hash": {
          "type": "string"
        }
      }
    },
    "compliance": {
      "type": "object",
      "required": [
        "ruleset",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "ruleset": {
          "$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string"
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": [
        "id",
        "review_status",
        "mapping_level",
        "relationship",
        "traceability_strength",
        "blueprint_refs",
        "targets",
        "rationale",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/review_status"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review_decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_level": {
          "type": "string",
          "enum": [
            "compliance_row",
            "compliance_domain",
            "general_obligation"
          ]
        },
        "relationship": {
          "type": "string",
          "enum": [
            "satisfies",
            "supports",
            "related",
            "not_applicable"
          ]
        },
        "traceability_strength": {
          "type": "string",
          "enum": [
            "direct",
            "partial",
            "advisory",
            "unmapped"
          ]
        },
        "blueprint_refs": {
          "$ref": "#/$defs/blueprint_refs"
        },
        "targets": {
          "$ref": "#/$defs/targets"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_basis"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/confidence"
        }
      }
    },
    "blueprint_refs": {
      "type": "object",
      "required": [
        "fr_refs",
        "tbt_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "fr_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FR-BP-[A-Za-z0-9_.-]+$"
          },
          "uniqueItems": true
        },
        "tbt_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TBT-BP-[A-Za-z0-9_.-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "targets": {
      "type": "object",
      "required": [
        "compliance_rows",
        "compliance_domains"
      ],
      "additionalProperties": false,
      "properties": {
        "compliance_rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleset_row_ref"
          }
        },
        "compliance_domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compliance_domain_ref"
          }
        }
      }
    },
    "ruleset_row_ref": {
      "type": "object",
      "required": [
        "ruleset",
        "row"
      ],
      "additionalProperties": false,
      "properties": {
        "ruleset": {
          "$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"
        },
        "row": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compliance_domain_ref": {
      "type": "object",
      "required": [
        "ruleset",
        "domain"
      ],
      "additionalProperties": false,
      "properties": {
        "ruleset": {
          "$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "source_basis": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
