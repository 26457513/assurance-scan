{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/assurance-scan/raw/main/data/schemas/compliance-pack.schema.json",
  "title": "Compliance Pack",
  "description": "External compliance framework data (ASVS, PCI, NIST, etc.). Just the rows and their metadata — no project-specific mapping. FR catalogues reference these rows via `satisfies`.",
  "type": "object",
  "required": ["schema_version", "framework", "version", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "framework": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "properties": {
        "url": {"type": "string"},
        "license": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    },
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["row", "title"],
      "additionalProperties": false,
      "properties": {
        "row": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "section": {"type": "string"},
        "level": {"type": "string"},
        "metadata": {"type": "object"}
      }
    }
  }
}
