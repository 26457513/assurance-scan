{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/assurance-framework.schema.json",
  "title": "Assurance Framework Catalog",
  "description": "Reusable process framework containing gates, roles, criteria and requirement placeholders.",
  "type": "object",
  "required": ["schema_version", "assurance_framework", "version", "title", "roles", "processes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "assurance_framework": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*(-[0-9]+)?$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "assurance_profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile"}
    },
    "roles": {
      "type": "array",
      "items": {"$ref": "#/$defs/role"}
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/process"}
    },
    "process_links": {
      "type": "array",
      "description": "Relationships between gated processes in the same assurance framework.",
      "items": {"$ref": "#/$defs/process_link"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^ROLE-[A-Z0-9_.-]+$"},
        "title": {"type": "string", "minLength": 1},
        "party_type": {"type": "string", "enum": ["internal", "external", "authority", "assurance", "supplier", "user", "other"]},
        "description": {"type": "string"},
        "responsibilities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "process": {
      "type": "object",
      "required": ["id", "title", "gates"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "profiles": {"type": "array", "items": {"type": "string"}},
        "entry_conditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "exit_outcomes": {
          "type": "array",
          "items": {"$ref": "#/$defs/process_outcome"}
        },
        "transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/process_transition"}
        },
        "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}
      }
    },
    "process_outcome": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "authority_category": {"type": "string"},
        "status": {"type": "string", "enum": ["approved", "rejected", "conditional", "deferred", "triaged_out", "continued", "other"]}
      }
    },
    "process_transition": {
      "type": "object",
      "required": ["from", "to", "label"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "condition": {"type": "string"},
        "outcome": {"type": "string"},
        "style": {"type": "string", "enum": ["primary", "success", "warning", "danger", "muted"]}
      }
    },
    "process_link": {
      "type": "object",
      "required": ["from_process", "to_process", "relationship"],
      "additionalProperties": false,
      "properties": {
        "from_process": {"type": "string", "minLength": 1},
        "from_gate": {"type": "string"},
        "from_outcome": {"type": "string"},
        "to_process": {"type": "string", "minLength": 1},
        "to_gate": {"type": "string"},
        "relationship": {"type": "string", "enum": ["enables", "triggers", "informs", "depends_on", "supersedes", "related"]},
        "label": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "gate": {
      "type": "object",
      "required": ["id", "title", "sequence", "criteria"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "description": {"type": "string"},
        "profiles": {"type": "array", "items": {"type": "string"}},
        "continuation_policy": {"$ref": "#/$defs/evidence_policy"},
        "required_roles": {"type": "array", "items": {"$ref": "#/$defs/gate_role"}},
        "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}}
      }
    },
    "gate_role": {
      "type": "object",
      "required": ["role", "responsibility"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "pattern": "^ROLE-[A-Z0-9_.-]+$"},
        "responsibility": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/graph_responsibility"},
        "required": {"type": "boolean", "default": true},
        "profiles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "title", "requirements"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "profiles": {"type": "array", "items": {"type": "string"}},
        "required": {"type": "boolean", "default": true},
        "blocks_continuation": {"type": "boolean", "default": true},
        "evidence_policy": {"$ref": "#/$defs/evidence_policy"},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/criterion_requirement"}}
      }
    },
    "criterion_requirement": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["fr_placeholder", "ruleset_row", "manual_artifact", "approval", "waiver", "compensating_control", "decision"]},
        "ref": {"type": "string", "minLength": 1},
        "ruleset": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "row": {"type": "string"},
        "required": {"type": "boolean", "default": true}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "ruleset_row"}}, "required": ["type"]},
          "then": {"required": ["ruleset", "row"]}
        }
      ]
    },
    "evidence_policy": {
      "type": "string",
      "enum": ["all_required", "any_required", "automated_required", "manual_plus_automated", "manual_decision"]
    }
  }
}
