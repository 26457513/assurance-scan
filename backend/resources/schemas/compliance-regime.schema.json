{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/compliance-regime.schema.json",
  "title": "Compliance Regime Metadata",
  "description": "Versioned metadata for a compliance regime or standard. Ruleset snapshots carry the rows; regime metadata carries display, source, grouping and applicability semantics.",
  "type": "object",
  "required": ["schema_version", "regime", "version", "title", "ruleset_ref", "source", "families"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "regime": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "short_title": {"type": "string"},
    "description": {"type": "string"},
    "ruleset_ref": {
      "type": "object",
      "required": ["ruleset", "version", "path"],
      "additionalProperties": false,
      "properties": {
        "ruleset": {"$ref": "https://github.com/jondowson/assurance-scan/raw/pivot/data/schemas/defs.schema.json#/$defs/ruleset_id"},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["url", "license"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "publisher": {"type": "string"},
        "retrieved_at": {"type": "string"},
        "source_file": {"type": "string"}
      }
    },
    "family_axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string"},
        "row_field": {"type": "string"},
        "ui_label": {"type": "string"}
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_scope": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commitment_role": {"type": "string", "const": "compliance_regime"},
        "zk_disclosure": {"type": "string"}
      }
    }
  }
}
