FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ARG VERSION=0.0.0-dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="Assurance Scan GitHub uploader" \
      org.opencontainers.image.description="Credential-isolated GitHub OIDC result uploader" \
      org.opencontainers.image.source="https://github.com/26457513/assurance-scan" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 assurance \
    && useradd --system --uid 65532 --gid assurance --no-create-home assurance

WORKDIR /opt/assurance-scan/backend
COPY backend/scripts/ci-upload.py ./scripts/ci-upload.py
COPY backend/app/__init__.py ./app/__init__.py
COPY backend/app/infrastructure/__init__.py ./app/infrastructure/__init__.py
COPY backend/app/infrastructure/github_oidc_upload.py ./app/infrastructure/github_oidc_upload.py
COPY backend/app/modules/__init__.py ./app/modules/__init__.py
COPY backend/app/modules/atomic/__init__.py ./app/modules/atomic/__init__.py
COPY backend/app/modules/atomic/ingestion/__init__.py ./app/modules/atomic/ingestion/__init__.py
COPY backend/app/modules/atomic/ingestion/github_oidc_upload_client/ ./app/modules/atomic/ingestion/github_oidc_upload_client/
COPY backend/app/modules/shared/ ./app/modules/shared/

ENV PYTHONPATH=/opt/assurance-scan/backend \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER 65532:65532
ENTRYPOINT ["python3", "/opt/assurance-scan/backend/scripts/ci-upload.py"]
